{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "vitest": ["../../../packages/eve/node_modules/vitest"] }
  },
  "include": ["agent/**/*.ts", "evals/**/*.ts"]
}
